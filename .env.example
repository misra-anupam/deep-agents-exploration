# Models run through OpenRouter. Ids: https://openrouter.ai/models (use the 'openrouter:' prefix)
OPENROUTER_API_KEY=
EQUITY_DESK_MODEL=openrouter:anthropic/claude-sonnet-5.5
# Optional: a different family for the red team, and a cheaper model for the other subagents
# EQUITY_DESK_REDTEAM_MODEL=openrouter:openai/gpt-5.6-terra
# EQUITY_DESK_SUBAGENT_MODEL=openrouter:anthropic/claude-haiku-5.5
# Other providers still work: 'anthropic:...' needs ANTHROPIC_API_KEY, 'openai:...' needs OPENAI_API_KEY
# fixture (offline, synthetic ACME) or edgar (live SEC data)
EQUITY_DESK_DATA=fixture
# Required for EQUITY_DESK_DATA=edgar. SEC asks for a descriptive contact string.
EDGAR_USER_AGENT=
# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=equity-desk
